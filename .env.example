# ============================================================
# ESB Hub (esbhub.study) — Configuration d'Environnement
# ============================================================
# Copiez ce fichier en .env.local et renseignez vos valeurs privées.

# --- SUPABASE (Base de données, Auth & RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# --- URL DU SITE ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- RESEND (Service d'emails transactionnels) ---
RESEND_API_KEY=re_your_resend_api_key

# --- BACKBLAZE B2 (Stockage Cloud S3 pour les mémoires et cours) ---
B2_ENDPOINT="s3.us-west-004.backblazeb2.com"
B2_REGION="us-west-004"
B2_ACCESS_KEY_ID="your-b2-access-key-id"
B2_SECRET_ACCESS_KEY="your-b2-secret-access-key"
B2_BUCKET_NAME="esb-documents-prod"

# --- NOTIFICATIONS EMAIL (SMTP Fallback) ---
GMAIL_EMAIL="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-gmail-app-password"
SENDER_EMAIL="info@yourdomain.com"

# --- CLOUDFLARE TURNSTILE (Sécurité CAPTCHA anti-bot) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
TURNSTILE_HMAC_SECRET="your-turnstile-hmac-secret"
